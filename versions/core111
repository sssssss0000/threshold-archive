/*
THRESHOLD ARCHIVE
ENTRY 111
*/

body {
    background:
    linear-gradient(
        rgba(3,6,12,.55),
        rgba(3,6,12,.75)
    ),
    url("https://raw.githubusercontent.com/sssssss0000/threshold-archive/main/assets/background.jpg") center/cover fixed no-repeat!important;
    overflow-x:hidden!important;
}

.l-page,
#page,
.profile-head,
.c-layout,
.c-column,
.c-profile,
.c-brief,
.c-info,
.c-history,
.c-additionals,
.c-lists-info,
.b-stats_bar {
    background:transparent!important;
    border:none!important;
    box-shadow:none!important;
}

.profile-head {
    position:relative!important;
    min-height:520px!important;
    display:block!important;
}

.c-brief {
    position:absolute!important;
    left:50%!important;
    top:20px!important;
    transform:translateX(-50%)!important;
    width:420px!important;
    display:flex!important;
    flex-direction:column!important;
    align-items:center!important;
    justify-content:flex-start!important;
    background:rgba(5,8,14,.45)!important;
    backdrop-filter:blur(14px)!important;
    border-radius:28px!important;
    padding:25px!important;
    z-index:5!important;
}

.avatar img {
    border-radius:28px!important;
    box-shadow:
    0 20px 50px rgba(0,0,0,.6)!important;
}

.head.misc {
    margin-top:20px!important;
    text-align:center!important;
}

.aliases {
    font-family:var(--font-alt)!important;
    color:#edf4ff!important;
    font-size:34px!important;
    letter-spacing:.2em!important;
    line-height:1.2!important;
    white-space:normal!important;
    word-break:normal!important;
    text-align:center!important;
}

.notice {
    color:#92a3ba!important;
    text-align:center!important;
    line-height:1.5!important;
}

.c-history {
    position:absolute!important;
    left:40px!important;
    top:20px!important;
    width:300px!important;
    background:rgba(5,8,14,.45)!important;
    backdrop-filter:blur(14px)!important;
    border-radius:28px!important;
    padding:20px!important;
    opacity:1!important;
    z-index:3!important;
}

.c-history a {
    pointer-events:auto!important;
}

.c-info {
    position:absolute!important;
    right:40px!important;
    top:20px!important;
    width:320px!important;
    margin:0!important;
    z-index:3!important;
}

.c-lists-info,
.c-additionals {
    background:rgba(5,8,14,.45)!important;
    backdrop-filter:blur(14px)!important;
    border-radius:28px!important;
    padding:20px!important;
    margin-bottom:20px!important;
}

.subheadline {
    background:none!important;
    border:none!important;
}

.subheadline a {
    color:#edf4ff!important;
    letter-spacing:.2em!important;
    text-transform:uppercase!important;
}

.b-stats_bar {
    background:rgba(5,8,14,.45)!important;
    backdrop-filter:blur(14px)!important;
    border-radius:28px!important;
    padding:20px!important;
}

.b-stats_bar .bar {
    background:rgba(255,255,255,.08)!important;
    border-radius:999px!important;
    overflow:hidden!important;
}

.b-stats_bar .stat_name a {
    color:#aab8cc!important;
}

.b-stats_bar .stat_name a:hover {
    color:#fff!important;
}

.c-column,
.b-catalog_entry,
.b-user_rate,
.cc-2 {
    border-radius:24px!important;
}

@media(max-width:1100px){
    .profile-head {
        min-height:auto!important;
        display:flex!important;
        flex-direction:column!important;
        align-items:center!important;
    }

    .c-brief,
    .c-history,
    .c-info {
        position:relative!important;
        left:auto!important;
        right:auto!important;
        top:auto!important;
        transform:none!important;
        width:90%!important;
        margin:20px auto!important;
    }
}
